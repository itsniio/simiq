{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{ "type": "command",
        "command": "jq -r '.tool_input.command' | grep -qE 'git (add (-A|--all|\\.)([[:space:]]|$)|commit -a)' && { echo 'Name the paths — no sweeping adds (shared trees).' >&2; exit 2; } || exit 0" }]
    }]
  },
  "attribution": { "commit": "", "pr": "" },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": { "source": "github", "repo": "addyosmani/agent-skills" }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true,
    "figma@claude-plugins-official": true
  }
}
