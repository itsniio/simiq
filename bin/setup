#!/usr/bin/env bash
# Prepares a machine to work on simiq: tools, the pinned OpenSpec CLI, the Claude Code plugins.
#   bin/setup          install what needs no sudo (OpenSpec, pnpm), report the rest
#   bin/setup --check  report only, change nothing
set -euo pipefail
cd "$(dirname "$0")/.."

OPENSPEC_VERSION=1.14.1   # the same pin as .github/workflows/ci.yml
NODE_MAJOR_MIN=22
PLUGINS=(superpowers@claude-plugins-official agent-skills@addy-agent-skills figma@claude-plugins-official)

check_only=false
[[ "${1:-}" == "--check" ]] && check_only=true
missing=0

ok()  { printf '  ok       %s\n' "$1"; }
fix() { printf '  missing  %s\n           -> %s\n' "$1" "$2"; missing=$((missing + 1)); }
have() { command -v "$1" >/dev/null 2>&1; }

need() {
  if have "$1"; then ok "$1 ($("$1" --version 2>/dev/null | head -1))"; else fix "$1" "$2"; fi
}

echo "Tools"
need git    "brew install git"
need gh     "brew install gh"
need jq     "brew install jq   (the hook in .claude/settings.json needs it)"
need uv     "brew install uv"
need claude "install Claude Code: https://claude.com/claude-code"

if have node; then
  major=$(node -p 'process.versions.node.split(".")[0]')
  if (( major >= NODE_MAJOR_MIN )); then ok "node $(node --version)"; else fix "node >= $NODE_MAJOR_MIN" "brew install node"; fi
else
  fix "node >= $NODE_MAJOR_MIN" "brew install node"
fi

if have gh && ! gh auth status >/dev/null 2>&1; then fix "gh login" "gh auth login"; fi

# Installed with npm, so they need node; nothing else is installed by this script.
current=$(have openspec && openspec --version 2>/dev/null || true)
if [[ "$current" == "$OPENSPEC_VERSION" ]]; then
  ok "openspec $current"
elif ! $check_only && have npm; then
  npm install --global --silent "@fission-ai/openspec@$OPENSPEC_VERSION" && ok "openspec $OPENSPEC_VERSION (installed)"
else
  fix "openspec $OPENSPEC_VERSION (have: ${current:-none})" "npm install -g @fission-ai/openspec@$OPENSPEC_VERSION"
fi

if have pnpm; then
  ok "pnpm $(pnpm --version)"
elif ! $check_only && have npm; then
  npm install --global --silent pnpm && ok "pnpm $(pnpm --version) (installed)"
else
  fix pnpm "npm install -g pnpm"
fi

echo "Claude Code plugins (declared in .claude/settings.json)"
installed="$HOME/.claude/plugins/installed_plugins.json"
for plugin in "${PLUGINS[@]}"; do
  if [[ -f "$installed" ]] && have jq && jq -e --arg p "$plugin" '(.plugins // .) | has($p)' "$installed" >/dev/null; then
    ok "$plugin"
  else
    fix "$plugin" "open this folder in Claude Code, trust it and accept the plugin prompt (or run /plugin)"
  fi
done

echo "Folders"
if [[ -d data/private ]]; then
  ok "data/private/ (gitignored)"
elif $check_only; then
  fix "data/private/" "bin/setup"
else
  mkdir -p data/private && ok "data/private/ (gitignored)"
fi

echo
if (( missing > 0 )); then
  echo "$missing item(s) to fix, listed above."
  exit 1
fi
echo "Ready. In Claude Code, run /mcp once to sign in to Figma."
